# Скопируй этот файл в .env и заполни своими значениями.
# .env никогда не коммитится (см. .gitignore).

TELEGRAM_BOT_TOKEN=
TOOKEN_API_KEY=

# Прокси и модель — на случай, если tooken.club сменит адрес или
# маппинг моделей, не придётся трогать код.
TOOKEN_API_URL=https://tooken.club/v1/messages
CLAUDE_MODEL=claude-sonnet-5

# Порог релевантности RAG (см. "Калибровка порога релевантности" в README).
RAG_TOP_K=6
RAG_MAX_DISTANCE=0.163

# Троттлинг по chat_id: минимум секунд между запросами одного
# пользователя и лимит запросов за скользящее окно.
RATE_LIMIT_MIN_INTERVAL=3
RATE_LIMIT_MAX_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# Ретраи на транзиентные сетевые сбои при обращении к прокси.
CLAUDE_MAX_RETRIES=2
CLAUDE_RETRY_BACKOFF_SECONDS=1

# Circuit breaker: после скольки сбоев подряд перестать бить в прокси
# и сразу отвечать "сервис недоступен", и на сколько секунд.
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
